{
    "name": "codesync-root",
    "version": "1.0.0",
    "description": "Root package for running client and server concurrently",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:backend": "cd backend && make dev",
        "dev:frontend": "cd frontend && npm run dev",
        "install:all": "npm install && cd frontend && npm install && cd ../backend && uv sync",
        "test": "concurrently \"npm run test:backend\" \"npm run test:frontend\"",
        "test:backend": "cd backend && make test",
        "test:frontend": "cd frontend && npm run test"
    },
    "devDependencies": {
        "concurrently": "^9.1.0"
    }
}